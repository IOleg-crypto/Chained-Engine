Project:
  Name: ChainedDecos
  IconPath: resources/icons/chaineddecos.jpg
  StartScene: scenes\start_menu.chscene
  AssetDirectory: assets
  ActiveScene: assets/scenes/rpg_strategy_scene.chscene
  Physics:
    Gravity: 17.2999992
    FixedTimestep: 0.00416666688
  Animation:
    TargetFPS: 60
  Render:
    ShadowResolution: 512
    EnableShadows: true
    AntiAliasingSamples: 2
  Mesh:
    ImportMaterials: true
    CalculateTangents: true
    FlipUVs: true
  Window:
    Width: 1920
    Height: 1080
    VSync: false
  Audio:
    MasterVolume: 1
    MusicVolume: 1
    SFXVolume: 1
  Runtime:
    Fullscreen: false
    ShowStats: true
    EnableConsole: false
    TargetFPS: 0
  Scripting:
    ModuleName: ChainedDecos.Scripts.dll
    ModuleDirectory: assets/bin
    AutoLoad: true
  Export:
    Mode: 2
    ZipThreshold: 0
    DataVersion: 0
    SplitSizeMB: 0
    PackName: resources
  BuildConfig: 0