<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Chained.Managed</AssemblyName>
    <RootNamespace>Chained</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>false</Optimize>
    <!-- Output path is controlled by the CMake build system to avoid stale DLL issues -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    
    <Authors>Oleg and Contributors</Authors>
    <Description>C# Base Class Library for Chained Engine.</Description>
    <RepositoryUrl>https://github.com/IOleg-crypto/ChainedEngine</RepositoryUrl>
  </PropertyGroup>



  <!-- Import dynamically generated properties from CMake -->
  <Import Project="ManagedDependencies.props" Condition="Exists('ManagedDependencies.props')" />

  <ItemGroup>
    <Reference Include="Coral.Managed">
      <HintPath>$(CoralManagedDir)/Coral.Managed.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The generator project lives as a subfolder; keep its sources out of this assembly. -->
  <ItemGroup>
    <Compile Remove="Chained.Managed.Generator/**/*.cs" />
    <None Remove="Chained.Managed.Generator/**" />
    <ProjectReference Include="Chained.Managed.Generator\Chained.Managed.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
